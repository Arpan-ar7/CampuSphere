# ─────────────────────────────────────────────────────────────
#  Copy this file to `.env.local` and change the values.
#  `.env.local` is ignored by git — never commit real secrets.
#
#  Everything starting with NEXT_PUBLIC_ is sent to the browser,
#  so NEVER put passwords, API keys or secrets in these.
# ─────────────────────────────────────────────────────────────

# true  = use the fake data in src/mock/data.js (no backend needed)
# false = call the real backend below
NEXT_PUBLIC_USE_MOCK=true

# Where the backend API lives (your friend's server)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
